# Copia a .env y aplica:  chmod 600 .env
# Genera claves fuertes:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

XIBALBA_API_KEYS="clave-burp-rotable-aqui,clave-cli-secundaria"
XIBALBA_UPSTREAM_BASE_URL="http://127.0.0.1:11434/v1"
# Para vLLM:  XIBALBA_UPSTREAM_BASE_URL="http://127.0.0.1:8001/v1"
# XIBALBA_UPSTREAM_API_KEY="si-vllm-exige-api-key"

XIBALBA_BIND_HOST="127.0.0.1"
XIBALBA_BIND_PORT=8000

XIBALBA_ALLOWED_MODELS=["qwen2.5-coder:32b","dolphin-mixtral:8x7b"]
XIBALBA_RATE_LIMIT="30/minute"
XIBALBA_MAX_CONCURRENCY=2
XIBALBA_MAX_BODY_BYTES=1048576
